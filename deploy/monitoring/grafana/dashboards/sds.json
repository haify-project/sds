{
 "uid": "sds-overview",
 "title": "SDS",
 "tags": [
  "sds"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "cluster",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "sds-prom"
    },
    "query": {
     "query": "label_values(up{job=\"sds\"}, cluster)",
     "refId": "q"
    },
    "definition": "label_values(up{job=\"sds\"}, cluster)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Cluster",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Controller up",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"sds\",cluster=~\"$cluster\"}",
     "legendFormat": "{{cluster}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "title": "Alerts firing",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (severity) (sds_controller_alerts_firing{cluster=~\"$cluster\"}) or vector(0)",
     "legendFormat": "{{severity}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 4,
   "title": "Nodes unreachable",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sds_controller_node_reachable{cluster=~\"$cluster\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "title": "Replicas not UpToDate",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sds_drbd_disk_state{cluster=~\"$cluster\",state!~\"UpToDate|Diskless\"} == 1) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "title": "Quorum lost",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sds_drbd_quorum{cluster=~\"$cluster\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "title": "Resources unreadable",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sds_drbd_resource_up{cluster=~\"$cluster\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Replication",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "title": "Disk states",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_drbd_disk_state{cluster=~\"$cluster\"} == 1",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   },
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    }
   ]
  },
  {
   "id": 10,
   "title": "Out-of-sync data",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_drbd_out_of_sync_bytes{cluster=~\"$cluster\"} > 0",
     "legendFormat": "{{cluster}} {{resource}} {{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Resync progress",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_drbd_resync_completed_ratio{cluster=~\"$cluster\"} < 1",
     "legendFormat": "{{cluster}} {{resource}} {{node}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "title": "Connections over TLS",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_drbd_connection_tls{cluster=~\"$cluster\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "Value": "tls"
      }
     }
    }
   ]
  },
  {
   "id": 13,
   "type": "row",
   "title": "Storage",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 14,
   "title": "Thin pool use",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_controller_pool_thin_used_percent{cluster=~\"$cluster\"}",
     "legendFormat": "{{cluster}} {{node}} {{pool}} {{kind}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "max": 100,
     "min": 0,
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 85
       },
       {
        "color": "red",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "title": "Capacity used",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 23,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_controller_storage_capacity_bytes{cluster=~\"$cluster\",state=\"used\"} / on (cluster,pool,node) sds_controller_storage_capacity_bytes{cluster=~\"$cluster\",state=\"total\"}",
     "legendFormat": "{{cluster}} {{node}} {{pool}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.85
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 16,
   "type": "row",
   "title": "Backups and placement",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 17,
   "title": "Last backup age",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - sds_controller_backup_last_success_timestamp_seconds{cluster=~\"$cluster\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    },
    {
     "refId": "B",
     "expr": "sds_controller_backup_last_shipped_bytes{cluster=~\"$cluster\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "age"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "shipped"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     }
    ]
   },
   "options": {},
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "Value #A": "age",
       "Value #B": "shipped"
      }
     }
    }
   ]
  },
  {
   "id": 18,
   "title": "Resources one machine's loss would take down",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sds_controller_resource_fault_domain_risk{cluster=~\"$cluster\"} == 1",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {
      "mode": "columns"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "job": true,
       "instance": true
      }
     }
    }
   ]
  },
  {
   "id": 19,
   "type": "row",
   "title": "Controller",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 20,
   "title": "API requests",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cluster, method) (rate(sds_controller_grpc_requests_total{cluster=~\"$cluster\"}[5m]))",
     "legendFormat": "{{cluster}} {{method}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 21,
   "title": "API latency p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (cluster, le) (rate(sds_controller_grpc_request_duration_seconds_bucket{cluster=~\"$cluster\"}[5m])))",
     "legendFormat": "{{cluster}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 22,
   "title": "Seconds since each source was read",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - sds_controller_last_observation_timestamp_seconds{cluster=~\"$cluster\"}",
     "legendFormat": "{{cluster}} {{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 23,
   "title": "Alerts firing by type",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "sds-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 48,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cluster, type, severity) (sds_controller_alerts_firing{cluster=~\"$cluster\"})",
     "legendFormat": "{{cluster}} {{type}} {{severity}}",
     "datasource": {
      "type": "prometheus",
      "uid": "sds-prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
}