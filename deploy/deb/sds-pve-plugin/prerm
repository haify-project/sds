#!/bin/sh
# prerm for sds-pve-plugin.
#
# Nothing destructive happens on removal: the modules go, the volumes and the
# storage.cfg entries stay. storage.cfg is cluster-wide, so an entry this node
# no longer understands may still be in use on every other node; the operator
# is told about it rather than having it edited.

set -e

case "$1" in
remove|deconfigure)
    if [ -f /etc/pve/storage.cfg ] && grep -q '^sds:' /etc/pve/storage.cfg; then
        echo "WARNING: /etc/pve/storage.cfg still has SDS storage entries:" >&2
        grep '^sds:' /etc/pve/storage.cfg >&2 || true
        echo "  Without the plugin this node cannot start guests whose disks are on them." >&2
        echo "  Remove the entries once no node uses them; the volumes are not touched." >&2
    fi
    ;;
upgrade|failed-upgrade)
    ;;
*)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
