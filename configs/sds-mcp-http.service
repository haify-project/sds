[Unit]
Description=drbd-reactor controlled sds-mcp (SDS MCP server over HTTP)
After=network-online.target sds-controller.service
Wants=network-online.target

[Service]
Type=simple
# Tokens live on the Self-HA mount, so they follow the server when it moves.
# SDS_MCP_ARGS carries the per-site flags, e.g.
#   SDS_MCP_ARGS="--public-url https://mcp.example.com --max-role operate --trust-proxy"
EnvironmentFile=-/var/lib/sds/mcp/sds-mcp.env
Environment=HOME=/var/lib/sds/mcp
WorkingDirectory=/var/lib/sds/mcp
ExecStart=/opt/sds/bin/sds-mcp serve --listen 0.0.0.0:43871 --controller 127.0.0.1:3374 --tokens /var/lib/sds/mcp/tokens.json $SDS_MCP_ARGS
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
