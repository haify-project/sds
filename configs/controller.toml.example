# SDS Controller Configuration

[server]
listen_address = "0.0.0.0"
port = 3374

[database]
# Database file path (default: /var/lib/sds/sds.db)
path = "/var/lib/sds/sds.db"

[dispatch]
# SSH configuration the controller uses to reach storage nodes.
# config_path matters whenever the controller does NOT run as a user whose
# ~/.dispatch/config.toml is the intended one (systemd unit with its own HOME,
# non-root operator, test harness). Leave it empty to keep dispatch's default
# discovery. A path that does not exist is rejected at startup.
config_path = "/root/.dispatch/config.toml"
# Max nodes a single dispatch call fans out to. 0 = built-in default (10).
parallel = 10

[wan]
# Controller-side cache for the shared CA + leaf used by the sds-proxy mTLS link
# (opt-in WAN replication only). Defaults to /var/lib/sds/wanproxy-pki, which
# only a root controller can create — point it somewhere writable otherwise.
# pki_dir = "/var/lib/sds/wanproxy-pki"

[tls]
enabled = false
# ca_cert = "/etc/sds/certs/ca.crt"
# client_cert = "/etc/sds/certs/client.crt"
# client_key = "/etc/sds/certs/client.key"

[log]
level = "info"  # debug, info, warn, error
format = "json"  # json or text

[storage]
default_pool_type = "vg"
default_snapshot_suffix = "_snap"

[metrics]
enabled = true
listen_address = "0.0.0.0"
port = 9090

[ui]
enabled = true
listen_address = "0.0.0.0"
port = 8080