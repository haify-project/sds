# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

bin/

node_modules/

# Embedded UI build artifact (copied from web-ui/dist during make build).
# .gitkeep stays tracked so ui/dist always exists: go:embed (ui/ui.go) needs at
# least one file there or `go build ./...` fails on a fresh clone.
ui/dist/*
!ui/dist/.gitkeep

# Stray local build outputs
/cli
/controller
.playwright-mcp/

# stray local screenshots
sds-dashboard.png
sds-resource-status.png

# transient subagent worktrees
.claude/worktrees/

# Compiled binaries — never commit (a 75MB sds-ai binary once bloated history)
cmd/sds-ai/sds-ai

# understand-anything: keep the graph and its incremental baseline, drop scratch.
# The graph is worth ~1h and a few million tokens to rebuild, and fingerprints.json
# is what lets a later run touch only the files that changed.
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/.trash-*/
/dist/

# Local agent/tool state, never published
.claude/
.mcp.json
.understand-anything/
data/
